{
  "$defs": {
    "buf.protoschema.test.v1.CrossFileEventEnvelope.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Test message that references both local and external messages in Any constraints",
      "properties": {
        "id": {
          "default": "",
          "type": "string"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/buf.protoschema.test.v1.LocalMessage.jsonschema.json"
            },
            {
              "$ref": "#/$defs/buf.protoschema.test.v1.ExternalMessageD.jsonschema.json"
            },
            {
              "$ref": "#/$defs/buf.protoschema.test.v1.ExternalMessageE.jsonschema.json"
            }
          ]
        }
      },
      "title": "Cross File Event Envelope",
      "type": "object"
    },
    "buf.protoschema.test.v1.ExternalMessageD.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "External message referenced from cross-file Any constraints",
      "patternProperties": {
        "^(field_d)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "fieldD": {
          "default": "",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "External MessageD",
      "type": "object"
    },
    "buf.protoschema.test.v1.ExternalMessageE.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Another external message for testing",
      "patternProperties": {
        "^(field_e)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "fieldE": {
          "default": "",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "External MessageE",
      "type": "object"
    },
    "buf.protoschema.test.v1.LocalMessage.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Local message in the same file",
      "patternProperties": {
        "^(local_field)$": {
          "default": "",
          "type": "string"
        },
        "^(local_flag)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "localField": {
          "default": "",
          "type": "string"
        },
        "localFlag": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Local Message",
      "type": "object"
    }
  },
  "$id": "buf.protoschema.test.v1.CrossFileEventEnvelope.jsonschema.bundle.json",
  "$ref": "#/$defs/buf.protoschema.test.v1.CrossFileEventEnvelope.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
