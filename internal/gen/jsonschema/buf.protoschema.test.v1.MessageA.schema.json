{
  "$id": "buf.protoschema.test.v1.MessageA.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Test payload message types",
  "patternProperties": {
    "^(fieldA)$": {
      "default": "",
      "type": "string"
    }
  },
  "properties": {
    "field_a": {
      "default": "",
      "type": "string"
    },
    "number": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        }
      ],
      "default": 0
    }
  },
  "title": "MessageA",
  "type": "object"
}
