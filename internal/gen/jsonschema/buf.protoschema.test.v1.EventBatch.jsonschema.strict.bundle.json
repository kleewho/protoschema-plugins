{
  "$defs": {
    "buf.protoschema.test.v1.EventBatch.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "description": "Test message for repeated Any field with constraints",
      "properties": {
        "events": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/buf.protoschema.test.v1.MessageA.jsonschema.strict.json"
              },
              {
                "$ref": "#/$defs/buf.protoschema.test.v1.MessageB.jsonschema.strict.json"
              },
              {
                "$ref": "#/$defs/buf.protoschema.test.v1.MessageC.jsonschema.strict.json"
              }
            ]
          },
          "type": "array"
        }
      },
      "title": "Event Batch",
      "type": "object"
    },
    "buf.protoschema.test.v1.MessageA.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "description": "Test payload message types",
      "properties": {
        "fieldA": {
          "type": "string"
        },
        "number": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        }
      },
      "required": [
        "fieldA",
        "number"
      ],
      "title": "MessageA",
      "type": "object"
    },
    "buf.protoschema.test.v1.MessageB.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "properties": {
        "fieldB": {
          "type": "string"
        },
        "flag": {
          "type": "boolean"
        }
      },
      "required": [
        "fieldB",
        "flag"
      ],
      "title": "MessageB",
      "type": "object"
    },
    "buf.protoschema.test.v1.MessageC.jsonschema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "properties": {
        "fieldC": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ],
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "fieldC",
        "value"
      ],
      "title": "MessageC",
      "type": "object"
    }
  },
  "$id": "buf.protoschema.test.v1.EventBatch.jsonschema.strict.bundle.json",
  "$ref": "#/$defs/buf.protoschema.test.v1.EventBatch.jsonschema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
