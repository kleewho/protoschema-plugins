{
  "$id": "buf.protoschema.test.v1.CrossFileEventEnvelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Test message that references both local and external messages in Any constraints",
  "properties": {
    "id": {
      "default": "",
      "type": "string"
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "buf.protoschema.test.v1.LocalMessage.schema.json"
        },
        {
          "$ref": "buf.protoschema.test.v1.ExternalMessageD.schema.json"
        },
        {
          "$ref": "buf.protoschema.test.v1.ExternalMessageE.schema.json"
        }
      ]
    }
  },
  "title": "Cross File Event Envelope",
  "type": "object"
}
